generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model env_tipo_contenedor {
  tip_codigo      Int     @id
  tip_descripcion String  @db.VarChar(250)
  tip_pies        Int
  tip_palets      Float   @db.Float
  tip_peso        Decimal @db.Decimal(10, 2)
  tip_situacion   Int
}

model sis_estado {
  est_codigo           Int           @id
  est_nombre           String        @db.VarChar(150)
  est_abreviacion      String        @db.VarChar(5)
  est_situacion        Int
  est_usuario_registra Int
  cus_address          cus_address[]
}

model sis_pais {
  pai_codigo    Int           @id
  pai_nombre    String        @db.VarChar(250)
  pai_situacion Int
  cus_address   cus_address[]
}

model inv_articulo {
  art_codigo                Int                @id
  art_codigo_interno        String             @db.VarChar(15)
  art_pais                  Int
  art_barcode               String             @db.VarChar(100)
  art_categoria             Int?
  art_marca                 Int?
  art_proveedor             Int?               @default(0)
  art_nombre                String             @db.VarChar(100)
  art_descripcion           String?            @db.Text
  art_descripcion_2         String?            @db.Text
  art_perecedero            Int?
  art_tiempo_vida           String?            @db.VarChar(150)
  art_volumen               String?            @db.VarChar(250)
  art_cuenta                String?            @db.VarChar(250)
  art_cantidad              Decimal            @db.Decimal(10, 2)
  art_unidad_medida         String?            @db.VarChar(250)
  art_largo                 Decimal            @db.Decimal(10, 2)
  art_ancho                 Decimal            @db.Decimal(10, 2)
  art_alto                  Decimal            @db.Decimal(10, 2)
  art_dimesiones_unidad     String             @db.VarChar(250)
  art_moneda                Int
  art_precio_compra         Decimal?           @default(0.00) @db.Decimal(10, 2)
  art_precio_costo          Decimal?           @default(0.00) @db.Decimal(10, 2)
  art_precio_venta          Decimal?           @default(0.00) @db.Decimal(10, 2)
  art_peso_caja             Decimal            @db.Decimal(10, 2)
  art_palet_caja            Decimal            @db.Decimal(10, 2)
  art_cajas_nivel           Int
  art_nivel_palets          Int
  art_alto_palets           Float              @db.Float
  art_etiquetas             Int
  art_dimensiones_etiquetas String             @db.VarChar(150)
  art_participacion         Int
  art_numero_fda            String             @db.VarChar(150)
  art_fce                   Int
  art_hts                   Int
  art_fda_producto          Int
  art_observaciones         String             @db.Text
  art_usuario_update        BigInt
  art_fecha_update          DateTime           @db.DateTime(0)
  art_situacion             Int
  shp_cart                  shp_cart[]
  shp_order_detail          shp_order_detail[]
}

model inv_articulo_imagen {
  img_codigo           Int
  img_articulo         Int
  img_archivo          String   @db.VarChar(250)
  img_previsualizacion Int      @db.TinyInt
  img_tipo             Int
  img_fecha_registro   DateTime @db.DateTime(0)
  img_usuario_registro BigInt

  @@id([img_codigo, img_articulo])
}

model shp_customer {
  cli_codigo       Int    @id @default(autoincrement())
  cli_nombre       String @db.VarChar(150)
  cli_abreviacion  String @db.VarChar(150)
  cli_razon_social String @db.VarChar(150)

  cli_duns                    String    @db.VarChar(150)
  cli_ein                     String    @db.VarChar(150)
  cli_monto_credito_asegurado String    @db.VarChar(150)
  cli_credito_autorizado      String    @db.VarChar(150)
  cli_terms_credito           String    @db.VarChar(150)
  cli_fecha_registro          DateTime? @db.DateTime(0)

  cli_usuario   String?
  cli_password  String? @db.VarChar(150)
  cli_situacion Int

  cli_inicio_sesion DateTime?     @db.DateTime(0)
  cus_address       cus_address[]
  cus_contact       cus_contact[]
  shp_order         shp_order[]
}

model cus_address {
  add_codigo    Int    @id @default(autoincrement())
  add_cliente   Int
  add_tipo      Int
  add_calle     String @db.VarChar(150)
  add_calle_2   String @db.VarChar(150)
  add_ciudad    String
  add_estado    Int
  add_pais      Int
  add_zipcode   String @db.VarChar(150)
  add_situacion Int
  add_defecto   Int    @default(0)

  cliente shp_customer     @relation(fields: [add_cliente], references: [cli_codigo])
  pais    sis_pais         @relation(fields: [add_pais], references: [pai_codigo])
  estado  sis_estado       @relation(fields: [add_estado], references: [est_codigo])
  tipo    cus_address_type @relation(fields: [add_tipo], references: [cat_codigo])
}

model cus_contact {
  con_codigo     Int     @id @default(autoincrement())
  con_cliente    Int
  con_nombre     String  @db.VarChar(150)
  con_cargo      String  @db.VarChar(150)
  con_telefono_1 String  @db.VarChar(150)
  con_telefono_2 String? @db.VarChar(150)
  con_email      String  @db.VarChar(150)
  con_situacion  Int
  con_defecto    Int     @default(0)

  cliente shp_customer @relation(fields: [con_cliente], references: [cli_codigo])
}

model con_type {
  cot_codigo      Int    @id @default(autoincrement())
  cot_descripcion String @db.VarChar(150)
}

model cus_address_type {
  cat_codigo      Int           @id @default(autoincrement())
  cat_descripcion String        @db.VarChar(150)
  cus_address     cus_address[]
}

model shp_admin {
  adm_codigo    Int    @id @default(autoincrement())
  adm_nombre    String @db.VarChar(150)
  adm_usuario   String @db.VarChar(150)
  adm_password  String @db.VarChar(150)
  adm_tipo      Int
  adm_situacion Int
}

model shp_cart {
  car_codigo         Int      @id @default(autoincrement())
  car_cliente        Int
  car_articulo       Int
  car_cantidad       Int
  car_fecha_registro DateTime @db.DateTime(0)

  artiulo inv_articulo @relation(fields: [car_articulo], references: [art_codigo])
}

model shp_price_penalty {
  ppe_codigo     Int     @id @default(autoincrement())
  ppe_percentage Decimal @db.Decimal(10, 2)
  ppe_penalty    Decimal @db.Decimal(10, 2)
  ppe_situacion  Int
}

model shp_order {
  ord_codigo         Int                @id @default(autoincrement())
  ord_cliente        Int
  ord_fecha          DateTime           @db.DateTime(0)
  ord_fecha_entrega  DateTime?          @db.DateTime(0)
  ord_fecha_registro DateTime?          @db.DateTime(0)
  ord_total          Decimal?           @db.Decimal(10, 2)
  ord_situacion      Int
  shp_order_detail   shp_order_detail[]

  cliente shp_customer @relation(fields: [ord_cliente], references: [cli_codigo])
}

model shp_order_detail {
  ord_codigo          Int     @id @default(autoincrement())
  shp_order_codigo    Int
  ord_articulo_codigo Int
  ord_cantidad        Int
  ord_precio          Decimal @db.Decimal(10, 2)
  ord_total           Decimal @db.Decimal(10, 2)
  ord_situacion       Int
  percent_discount    Decimal @db.Decimal(10, 2)

  order   shp_order    @relation(fields: [shp_order_codigo], references: [ord_codigo])
  article inv_articulo @relation(fields: [ord_articulo_codigo], references: [art_codigo])
}
